{
  "realm": "demo-app",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 86400,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 1800,
  "offlineSessionIdleTimeout": 1800,
  "refreshTokenMaxReuse": 0,
  "revokeRefreshToken": true,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "roles": {
    "realm": [
      {
        "name": "claimant",
        "description": "Claimant role - Can create and view own claims only"
      },
      {
        "name": "admin",
        "description": "Administrator role - Can view all claims, all users, manage claims, access dashboard"
      }
    ]
  },
  "clients": [
    {
      "clientId": "demo-app-ui",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
