{
  "name": "demo-app-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "prebuild": "npm run generate:api",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "generate:api": "npx --yes @openapitools/openapi-generator-cli generate -i ../bff-service/src/main/resources/openapi/bff-api.yml -g typescript-fetch -o src/lib/api/generated --additional-properties=supportsES6=true,typescriptThreePlus=true",
    "generate:stubs": "python3 ../../scripts/generate-wiremock-stubs.py ../bff-service/src/main/resources/openapi/bff-api.yml mocks/bff-stubs bff",
    "mock:bff": "./scripts/start-wiremock.sh 8080",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@hookform/resolvers": "^5.2.2",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "react-hot-toast": "^2.6.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.3.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jose": "^6.1.3",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
